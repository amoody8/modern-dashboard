<?xml version="1.0"?>
<ruleset name="Modern Dashboard">
	<description>Coding standards for the Modern Dashboard plugin.</description>

	<file>.</file>

	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<!-- Deliberately stubs WordPress functions and globals. -->
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress-Extra">
		<!--
			This plugin autoloads PSR-4, so class files are named for their class
			(Store.php, not class-store.php). The two conventions cannot both hold.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress-Docs">
		<!--
			Typed signatures and return types already say what these sniffs want a
			docblock to repeat. Comments in this codebase are reserved for
			explaining *why* something is done, not restating the signature.
			Array shapes, filters and anything non-obvious are still documented.
		-->
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<!-- `$value ?: $fallback` is used deliberately for empty-string fallbacks. -->
	<rule ref="Universal.Operators.DisallowShortTernary">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="modern-dashboard"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ModernDashboard"/>
				<element value="modern_dashboard"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
